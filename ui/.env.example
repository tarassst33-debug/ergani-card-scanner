# Αντίγραψε σε .env (μην το ανεβάσεις στο git) και φόρτωσέ το πριν το run.

# Υποχρεωτικό — σταθερό μυστικό (ίδιο πάντα, αλλιώς χάνονται οι κωδικοί Ergani)
ERGANI_UI_SECRET=βάλε-εδώ-64-hex-chars-openssl-rand-hex-32

# Firebase project (στο Console: projectcar-7846b)
FIREBASE_PROJECT_ID=projectcar-7846b
# Service account JSON — ή βάλε το αρχείο στο ui/secrets/firebase-service-account.json
ERGANI_FIREBASE_CREDENTIALS=/absolute/path/to/service-account.json

# Πρώτη εκκίνηση (μόνο αν η Firestore είναι άδεια)
ERGANI_UI_ADMIN_USER=admin
ERGANI_UI_ADMIN_PASSWORD=βάλε-ισχυρό-κωδικό-12+

# Τοπική demo: ενημέρωση hash admin από .env σε κάθε εκκίνηση (μην σε production internet)
# ERGANI_UI_SYNC_ADMIN_PASSWORD=1

# Mobile kiosk (tablet card scanner) — openssl rand -hex 24
# ERGANI_KIOSK_DEVICE_KEY=
# ERGANI_KIOSK_COMPANY_ID=1
# ERGANI_KIOSK_BRANCH_NUMBER=0
# ERGANI_KIOSK_EMPLOYER_AFM=801965762
# ERGANI_UI_HOST=0.0.0.0

# Προαιρετικό — μόνο εσύ μπορείς να συνδεθείς (comma-separated)
# ERGANI_UI_ALLOWED_USERS=Δημητρης

# HTTPS / production cookie
# ERGANI_UI_HTTPS=1
